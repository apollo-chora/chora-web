{
  "name": "chora-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:skeleton": "playwright test --project=phyllis-skeleton",
    "lint": "ng lint",
    "storybook": "ng run chora-web:storybook",
    "build-storybook": "ng run chora-web:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@angular/cdk": "^21.2.3",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@ngx-translate/core": "^17.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.0",
    "@analogjs/vitest-angular": "^2.6.0",
    "@angular-devkit/build-angular": "^21.2.10",
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/angular": "^10.4.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "^21.4.0",
    "chromatic": "^16.10.1",
    "eslint": "^10.4.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "storybook": "^10.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.11",
    "zone.js": "^0.15.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.9.16",
    "protobufjs": "^7.6.1",
    "websocket-driver": "^0.7.5"
  }
}
