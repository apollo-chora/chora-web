# Never send local secrets/config into the Docker build context.
.env
.env.*
!.env.example

# VCS + editor
.git
.gitignore
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node + build output (rebuilt inside the image)
node_modules/
dist/
.angular/
coverage/
storybook-static/

# Test output
playwright-report/
test-results/
e2e-results.xml

# Secrets
*.pem
*.key
